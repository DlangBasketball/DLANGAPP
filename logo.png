import logoUrl from '../assets/logo.png';

const navItems = [
  {
    section: 'Run',
    items: [
      { id: 'dashboard', label: 'Dashboard', icon: <><rect x="3" y="3" width="7" height="9"/><rect x="14" y="3" width="7" height="5"/><rect x="14" y="12" width="7" height="9"/><rect x="3" y="16" width="7" height="5"/></> },
      { id: 'athletes', label: 'Athletes', icon: <><circle cx="9" cy="7" r="4"/><path d="M3 21v-2a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v2"/><circle cx="17" cy="7" r="3"/><path d="M21 21v-2a4 4 0 0 0-3-3.87"/></> },
      { id: 'calendar', label: 'Schedule', icon: <><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></> },
      { id: 'programs', label: 'Camps & Programs', icon: <><path d="M3 21h18"/><path d="M5 21V7l8-4v18"/><path d="M19 21V11l-6-4"/></> },
      { id: 'payments', label: 'Payments', icon: <><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></>, badge: 14 }
    ]
  },
  {
    section: 'Tools',
    items: [
      { id: 'ai', label: 'AI Assistant', icon: <><path d="M12 2L2 7l10 5 10-5-10-5z"/><polyline points="2 17 12 22 22 17"/></> },
      { id: 'parent', label: 'Parent app', icon: <><rect x="5" y="2" width="14" height="20" rx="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></> }
    ]
  }
];

export default function Sidebar({ activeScreen, onNavigate }) {
  return (
    <aside className="sidebar">
      <div className="club-brand">
        <img src={logoUrl} alt="DLang Basketball" className="club-logo" />
        <div className="club-meta">Lausanne · 312 athletes</div>
      </div>

      {navItems.map(group => (
        <div key={group.section}>
          <div className="nav-section">{group.section}</div>
          {group.items.map(item => (
            <a
              key={item.id}
              className={`nav-item ${activeScreen === item.id ? 'active' : ''}`}
              onClick={(e) => { e.preventDefault(); onNavigate(item.id); }}
            >
              <svg viewBox="0 0 24 24">{item.icon}</svg>
              {item.label}
              {item.badge && <span className="nav-badge">{item.badge}</span>}
            </a>
          ))}
        </div>
      ))}

      <div className="sidebar-footer">
        <div className="user-pill">
          <div className="user-avatar">DL</div>
          <div>
            <div className="user-name">D Lang</div>
            <div className="user-role">Founder · Director</div>
          </div>
        </div>
      </div>
    </aside>
  );
}
